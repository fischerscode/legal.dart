#!/bin/sh
set -eu
# Permit standard merge/revert headers; ordinary changes use Conventional Commits.
head -n 1 "$1" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^()]+\))?!?: .+|^Merge |^Revert "' || {
  echo 'Use a Conventional Commit, for example: feat: add SPDX support' >&2
  exit 1
}
